{
  "schemaVersion": 1,
  "screen": "S02-investigation-workspace",
  "purpose": "Operate the investigation from structured state.",
  "primaryQuestion": "What do we know, what explains it, and what should we do next?",
  "regions": [
    {
      "id": "observation",
      "purpose": "Expose observation needed to answer the screen's primary question.",
      "hierarchy": "primary",
      "visibility": {
        "kind": "always"
      }
    },
    {
      "id": "hypotheses",
      "purpose": "Expose hypotheses needed to answer the screen's primary question.",
      "hierarchy": "primary",
      "visibility": {
        "kind": "always"
      }
    },
    {
      "id": "blockers",
      "purpose": "Expose blockers needed to answer the screen's primary question.",
      "hierarchy": "secondary",
      "visibility": {
        "kind": "always"
      }
    },
    {
      "id": "next-actions",
      "purpose": "Expose next actions needed to answer the screen's primary question.",
      "hierarchy": "secondary",
      "visibility": {
        "kind": "always"
      }
    },
    {
      "id": "persistence-state",
      "purpose": "Expose persistence state needed to answer the screen's primary question.",
      "hierarchy": "tertiary",
      "visibility": {
        "kind": "always"
      }
    }
  ],
  "capabilities": [
    {
      "kind": "expose",
      "capability": "RecordObservation"
    },
    {
      "kind": "explain-when-unavailable",
      "capability": "RecordObservation"
    },
    {
      "kind": "expose",
      "capability": "RecordHypothesis"
    },
    {
      "kind": "explain-when-unavailable",
      "capability": "RecordHypothesis"
    },
    {
      "kind": "expose",
      "capability": "ConfirmCause"
    },
    {
      "kind": "explain-when-unavailable",
      "capability": "ConfirmCause"
    }
  ],
  "stateProjections": [
    {
      "when": "material-blocker-exists",
      "observations": [
        {
          "id": "blocker-visible",
          "description": "Any material blocker relevant to this screen remains perceivable and inspectable."
        },
        {
          "id": "no-false-authority",
          "description": "The UI does not imply an unavailable or unverified state is authoritative."
        }
      ]
    }
  ],
  "forbiddenPatterns": [
    "chat-only-primary-interface",
    "named:hide-material-blocker"
  ],
