<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>IndyInitRootCauseInvestigator.Engine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EchelonFoundry.Aegis.Core" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Primitives.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Decide.fs" />
    <Compile Include="Operational.fs" />
    <Compile Include="Faults.fs" />
    <Compile Include="CaseNames.fs" />
    <!-- Causa storage contract v1.0.0: byte-identical vendor copy of causa-data@causa-storage-v1.0.0
         tools/src/Causa.Contract (data/causa-storage-v1.0.0/VENDOR.json, scripts/verify-causa-vendor.mjs).
         Compiled into this assembly (before Codec.fs, whose internal Json module would otherwise shadow the
         contract's) so Shell can use it; it runs on this engine, the contract's pinned oracle. -->
    <Compile Include="../contract/Json.fs" />
    <Compile Include="../contract/Errors.fs" />
    <Compile Include="../contract/Wire.fs" />
    <Compile Include="../contract/Events.fs" />
    <Compile Include="../contract/Projection.fs" />
    <Compile Include="../contract/SchemaCheck.fs" />
    <Compile Include="../contract/Store.fs" />
    <Compile Include="Codec.fs" />
    <Compile Include="CausaData.fs" />
    <Compile Include="Sync.fs" />
    <Compile Include="CausaGitHub.fs" />
    <Compile Include="Report.fs" />
    <Compile Include="Routes.fs" />
    <Compile Include="Shell.fs" />
  </ItemGroup>
</Project>
