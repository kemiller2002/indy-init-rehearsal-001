{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echelonfoundry.dev/schemas/ecir-approval-v1.schema.json",
  "title": "ECIR exact-scope signed decision approval",
  "description": "Transport shape only. ECDSA signature verification, protected signer allow-list, source commit binding, time restrictions, and full trusted scope equality are mandatory at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "keyId",
    "approver",
    "issuedAt",
    "expiresAt",
    "scope",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ecir.approval/1"
    },
    "keyId": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "$ref": "#/$defs/utc"
    },
    "expiresAt": {
      "$ref": "#/$defs/utc"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groupId",
        "cohortId",
        "sourceCommit",
        "manifestDigest",
        "blueprintDigest",
        "requirementKeys",
        "decisionIds"
      ],
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "cohortId": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "manifestDigest": {
          "$ref": "#/$defs/digest"
        },
        "blueprintDigest": {
          "$ref": "#/$defs/digest"
        },
        "requirementKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "decisionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "contentEncoding": "base64",
      "description": "ECDSA P-256/SHA-256, IEEE-P1363 (64-byte r||s), base64; verify exact canonical bytes with out-of-repository public key"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Exact UTC second precision; runtime also checks validity and maximum 24 hour lifetime"
    }
  }
}
