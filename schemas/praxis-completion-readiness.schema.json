{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository-operating-system.local/schemas/praxis-completion-readiness.schema.json",
  "title": "praxis.completion-readiness/1",
  "description": "Completion readiness (PRX-QUAL-020..023), recorded additively as `completionReadiness` on a `work.completed` event and on the completed work-context item when workProtocol.qualityEvidence applies, when the item's risk metadata carries completion obligations, or when obligation evidence is supplied; printed (outcome: refused) by a refused `work complete`. Praxis consumes Dokimos, Ordo, design-debt, verification-matrix and release-readiness evidence; it never recomputes their verdicts. Unavailable evidence is never a pass. Every consumed evidence file is recorded with the SHA-256 digest of the bytes decoded. The documents Praxis consumes are defined under $defs (designDebtDocument, verificationMatrixDocument, releaseReadinessDocument) together with the work-item risk member (workRisk). A member of a grouped-mode group execution is always judged for the `group-verified` facet (PRX-GRP-135).",
  "type": "object",
  "required": [
    "schema",
    "workItem",
    "decision",
    "policy",
    "facets",
    "sources",
    "blockingReasons"
  ],
  "properties": {
    "schema": {
      "const": "praxis.completion-readiness/1"
    },
    "workItem": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "ready",
        "refused"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "dokimos",
        "ordoBoundary",
        "requiredFacets"
      ],
      "properties": {
        "dokimos": {
          "$ref": "#/$defs/requirement"
        },
        "dokimosBaseline": {
          "type": "string"
        },
        "ordoBoundary": {
          "$ref": "#/$defs/requirement"
        },
        "requiredFacets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/facetCode"
          }
        },
        "workTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "facets": {
      "type": "object",
      "required": [
        "implementationComplete",
        "behaviorVerified",
        "architectureVerified",
        "releaseReady",
        "designDebtDeclared",
        "verificationMatrixSatisfied"
      ],
      "properties": {
        "implementationComplete": {
          "$ref": "#/$defs/facet"
        },
        "behaviorVerified": {
          "$ref": "#/$defs/facet"
        },
        "architectureVerified": {
          "$ref": "#/$defs/facet"
        },
        "releaseReady": {
          "$ref": "#/$defs/facet"
        },
        "designDebtDeclared": {
          "$ref": "#/$defs/facet"
        },
        "verificationMatrixSatisfied": {
          "$ref": "#/$defs/facet"
        },
        "groupVerified": {"$ref": "#/$defs/facet", "description": "PRX-GRP-133..135: required only for a member of a grouped-mode group execution (judged whatever the policy); otherwise not-required. Absent in records written before it existed."}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "required": [
        "dokimos",
        "ordoBoundary"
      ],
      "properties": {
        "dokimos": {
          "$ref": "#/$defs/source"
        },
        "ordoBoundary": {
          "$ref": "#/$defs/source"
        },
        "designDebt": {
          "$ref": "#/$defs/source"
        },
        "verificationMatrix": {
          "$ref": "#/$defs/source"
        },
        "releaseReadiness": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": false
    },
    "blockingReasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "$ref": "#/$defs/workRisk"
    },
    "obligations": {
      "type": "object",
      "required": [
        "designDebtDeclaration",
        "verificationDimensions"
      ],
      "properties": {
        "designDebtDeclaration": {
          "type": "boolean"
        },
        "verificationDimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          }
        }
      },
      "additionalProperties": false
    },
    "consumedEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path",
          "sha256"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "requirement": {
      "enum": [
        "required",
        "optional",
        "off"
      ]
    },
    "facetCode": {
      "enum": [
        "implementation-complete",
        "behavior-verified",
        "architecture-verified",
        "release-ready",
        "design-debt-declared",
        "verification-matrix-satisfied"
      ]
    },
    "facet": {
      "type": "object",
      "required": [
        "required",
        "status",
        "blocking"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "satisfied",
            "not-satisfied",
            "unavailable",
            "not-required"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "evidenceType",
        "requirement",
        "judgement"
      ],
      "description": "Observation (not-supplied, ambiguous, parsed, unsupported, malformed) of one evidence source, the consumed fields of a parsed document, and Praxis's judgement of it. Absent observation: the source is off.",
      "properties": {
        "evidenceType": {
          "enum": [
            "dokimos-ratchet",
            "ordo-boundary",
            "design-debt",
            "verification-matrix",
            "release-readiness"
          ]
        },
        "requirement": {
          "$ref": "#/$defs/requirement"
        },
        "observation": {
          "enum": [
            "not-supplied",
            "ambiguous",
            "parsed",
            "unsupported",
            "malformed"
          ]
        },
        "path": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "judgement": {
          "enum": [
            "ignored",
            "passed",
            "failed",
            "unavailable"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "dimension": {
      "enum": [
        "happy-path",
        "negative",
        "corruption",
        "concurrency",
        "compatibility",
        "recovery",
        "live-effect"
      ]
    },
    "workRisk": {
      "title": "praxis.work-risk/1",
      "description": "Engineering-risk metadata a work item declares (PRX-QUAL-020), stored as `risk` on its queue item and set with `work update --change-class ... --risk-level ...`.",
      "type": "object",
      "required": [
        "schema",
        "changeClasses",
        "level"
      ],
      "properties": {
        "schema": {
          "const": "praxis.work-risk/1"
        },
        "changeClasses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "stateful-control-plane",
              "persistence",
              "release-bootstrap",
              "security",
              "remote-execution",
              "external-protocol",
              "feature",
              "refactor",
              "documentation",
              "tooling"
            ]
          }
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "persistentStateImpact": {
          "type": "boolean"
        },
        "externalProtocolImpact": {
          "type": "boolean"
        },
        "securityImpact": {
          "type": "boolean"
        },
        "failurePosture": {
          "enum": [
            "fail-open",
            "fail-closed",
            "indeterminate"
          ]
        },
        "tierOwnership": {
          "type": "array",
          "items": {
            "enum": [
              "domain",
              "contracts",
              "application",
              "infrastructure",
              "cli"
            ]
          }
        },
        "liveProof": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "designDebtDocument": {
      "title": "praxis.design-debt/1",
      "description": "Design-debt declaration (PRX-QUAL-021), supplied as `--evidence design-debt=PATH`. `knownDebt: none` lists no entries; `declared` lists at least one, each tracked by a recorded open work item other than this one. A prototype needs at least one entry.",
      "type": "object",
      "required": [
        "schema",
        "workItem",
        "knownDebt",
        "entries"
      ],
      "properties": {
        "schema": {
          "const": "praxis.design-debt/1"
        },
        "workItem": {
          "type": "string",
          "minLength": 1
        },
        "knownDebt": {
          "enum": [
            "none",
            "declared"
          ]
        },
        "prototype": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "workItem",
              "rationale",
              "risk",
              "compromisedBoundary"
            ],
            "properties": {
              "workItem": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "minLength": 1
              },
              "compromisedBoundary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "verificationMatrixDocument": {
      "title": "praxis.verification-matrix/1",
      "description": "Verification matrix (PRX-QUAL-022), supplied as `--evidence verification-matrix=PATH`. One row per dimension; a met row cites evidence; `location` references must exist; compilation or unit tests alone never satisfy the matrix; a live-effect row needs `live` evidence.",
      "type": "object",
      "required": [
        "schema",
        "workItem",
        "rows"
      ],
      "properties": {
        "schema": {
          "const": "praxis.verification-matrix/1"
        },
        "workItem": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "dimension",
              "status",
              "evidence"
            ],
            "properties": {
              "dimension": {
                "$ref": "#/$defs/dimension"
              },
              "status": {
                "enum": [
                  "met",
                  "not-met",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Required when status is not-applicable."
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "reference",
                    "result"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "build",
                        "unit-test",
                        "integration-test",
                        "command",
                        "location",
                        "live"
                      ]
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "releaseReadinessDocument": {
      "title": "praxis.release-readiness/1",
      "description": "Release-readiness evidence (PRX-QUAL-023), supplied as `--evidence release-readiness=PATH`. release-ready is satisfied only by verdict `ready` with at least one check and every check `passed`; a `ready` verdict over a failed or skipped check is inconsistent (unavailable); `not-ready` is not satisfied.",
      "type": "object",
      "required": [
        "schema",
        "release",
        "checkedAt",
        "verdict",
        "checks"
      ],
      "properties": {
        "schema": {
          "const": "praxis.release-readiness/1"
        },
        "release": {
          "type": "object",
          "required": [
            "name",
            "version",
            "commit"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "checkedAt": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "ready",
            "not-ready"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "status",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "skipped"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
