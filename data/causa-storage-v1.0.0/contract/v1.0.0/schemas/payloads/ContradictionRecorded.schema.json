{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/causa-data/contract/v1.0.0/schemas/payloads/ContradictionRecorded.schema.json",
  "title": "ContradictionRecorded payload",
  "description": "Records a contradiction among evidence; starts 'detected'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contradictionId",
    "statement",
    "evidenceIds",
    "materiality"
  ],
  "properties": {
    "contradictionId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "statement": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "evidenceIds": {
      "$ref": "../common.schema.json#/$defs/uuidList"
    },
    "materiality": {
      "$ref": "../common.schema.json#/$defs/materiality"
    }
  }
}
