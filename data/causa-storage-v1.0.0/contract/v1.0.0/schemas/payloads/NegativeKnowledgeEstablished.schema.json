{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/causa-data/contract/v1.0.0/schemas/payloads/NegativeKnowledgeEstablished.schema.json",
  "title": "NegativeKnowledgeEstablished payload",
  "description": "Records something established NOT to be the case, citing evidence (R5.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "negativeKnowledgeId",
    "statement",
    "scope",
    "basisEvidenceIds"
  ],
  "properties": {
    "negativeKnowledgeId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "statement": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "scope": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "basisEvidenceIds": {
      "$ref": "../common.schema.json#/$defs/nonEmptyUuidList"
    }
  }
}
