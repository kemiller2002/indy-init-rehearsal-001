{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/causa-data/contract/v1.0.0/schemas/schema-bundle.schema.json",
  "title": "Causa v1 schema bundle manifest (integrity metadata)",
  "description": "contract/v1.0.0/schemas/bundle.json. Each schema's digest is SHA-256 of its exact file bytes; the bundle identity is SHA-256 of the bundle manifest's exact file bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "contractVersion",
    "algorithm",
    "canonicalization",
    "schemas"
  ],
  "properties": {
    "formatVersion": {
      "$ref": "common.schema.json#/$defs/formatVersion"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "sha256"
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][A-Za-z0-9/._-]*\\.schema\\.json$"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    }
  }
}
