{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/causa-data/contract/v1.0.0/schemas/entities/prediction.schema.json",
  "title": "prediction projection entity",
  "description": "Prediction projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hypothesisId",
    "statement",
    "strength",
    "timing",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "hypothesisId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "statement": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "strength": {
      "$ref": "../common.schema.json#/$defs/predictionStrength"
    },
    "timing": {
      "$ref": "../common.schema.json#/$defs/predictionTiming"
    },
    "provenance": {
      "$ref": "../actor.schema.json#/$defs/provenance"
    }
  }
}
