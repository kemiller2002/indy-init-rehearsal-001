{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/causa-data/contract/v1.0.0/schemas/entities/criterion.schema.json",
  "title": "criterion projection entity",
  "description": "Verification criterion projection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "correctiveActionId",
    "expectedOutcome",
    "method",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "correctiveActionId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "expectedOutcome": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "method": {
      "$ref": "../common.schema.json#/$defs/nullableText"
    },
    "provenance": {
      "$ref": "../actor.schema.json#/$defs/provenance"
    }
  }
}
