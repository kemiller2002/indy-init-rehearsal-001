{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kemiller2002/causa-data/contract/v1.0.0/schemas/entities/unknown.schema.json",
  "title": "unknown projection entity",
  "description": "Unknown projection; basis is the latest transition basis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "question",
    "materiality",
    "state",
    "basis",
    "provenance"
  ],
  "properties": {
    "id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "question": {
      "$ref": "../common.schema.json#/$defs/text"
    },
    "materiality": {
      "$ref": "../common.schema.json#/$defs/materiality"
    },
    "state": {
      "$ref": "../common.schema.json#/$defs/unknownState"
    },
    "basis": {
      "$ref": "../common.schema.json#/$defs/nullableText"
    },
    "provenance": {
      "$ref": "../actor.schema.json#/$defs/provenance"
    }
  }
}
